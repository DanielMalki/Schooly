<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Academic Class Assignments"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter Classes by Grade"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="#1A237E"
        app:hintTextColor="#1A237E"
        android:layout_marginBottom="20dp">

        <AutoCompleteTextView
            android:id="@+id/spinnerFilterClassesGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp"/>

    <TextView android:text="Homeroom Class *" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1A237E" android:layout_marginBottom="4dp"/>
    <Spinner android:id="@+id/spinnerHomeroom" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="12dp"/>

    <TextView android:text="Math Group *" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1A237E" android:layout_marginBottom="4dp"/>
    <Spinner android:id="@+id/spinnerMathGroup" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="12dp"/>

    <TextView android:text="English Group *" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1A237E" android:layout_marginBottom="4dp"/>
    <Spinner android:id="@+id/spinnerEnglishGroup" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="12dp"/>

    <TextView android:text="Physical Education *" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1A237E" android:layout_marginBottom="4dp"/>
    <Spinner android:id="@+id/spinnerSportsGroup" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Elective Majors (Optional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="8dp"/>

    <Spinner android:id="@+id/spinnerMajor1Group" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="12dp"/>
    <Spinner android:id="@+id/spinnerMajor2Group" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="8dp"/>

</LinearLayout>