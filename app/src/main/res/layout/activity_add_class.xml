<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Learning Group"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#005088"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvSchoolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select School:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"
            android:visibility="gone"/>

        <Spinner
            android:id="@+id/spinnerSchoolSelect"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="15dp"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etSchoolLocked"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="10dp"
            android:background="#EEEEEE"
            android:enabled="false"
            android:textColor="#333333"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <View
            android:id="@+id/viewSchoolDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Group Name:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etClassName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g. 10th Grade Math - 5 Units"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Group Type:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <Spinner
            android:id="@+id/spinnerGroupType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignments (Subject &amp; Teacher):"
            android:textStyle="bold"
            android:textColor="#2E8B57"
            android:textSize="15sp"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:id="@+id/layoutPairsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAddPairRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Assignment"
            android:backgroundTint="#2E8B57"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnSaveClass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Create Group ✅"
            android:textSize="18sp"
            android:backgroundTint="#005088"
            android:textColor="@android:color/white"
            android:layout_marginBottom="30dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bulk Import (CSV)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload a CSV file with 2 columns:\nColumn 1: Group Name\nColumn 2: Type (homeroom/math/english/sports/major a/major b)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnImportCsv"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Select CSV File 📂"
            android:textSize="18sp"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</ScrollView>