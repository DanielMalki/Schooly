<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Learning Group"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#005088"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Group Name:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etClassName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g. 11-A, Math 5u *"
            android:background="#EEEEEE"
            android:padding="10dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Group Type:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <Spinner
            android:id="@+id/spinnerGroupType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvSchoolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School Assignment:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etSchoolLocked"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#E0E0E0"
            android:focusable="false"
            android:clickable="false"
            android:padding="10dp"
            android:textColor="#555555"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <Spinner
            android:id="@+id/spinnerSchoolSelect"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <View
            android:id="@+id/viewSchoolDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignments (Subject &amp; Teacher):"
            android:textStyle="bold"
            android:textColor="#2E8B57"
            android:textSize="15sp"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:id="@+id/layoutPairsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAddPairRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Assignment"
            android:backgroundTint="#2E8B57"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnSaveClass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Create Group ✅"
            android:textSize="18sp"
            android:backgroundTint="#005088"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>