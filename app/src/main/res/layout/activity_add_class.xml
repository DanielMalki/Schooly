<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Learning Group"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#005088"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etClassName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Group Name (e.g. 11-A, Math 5u) *"
            android:background="#EEEEEE"
            android:padding="10dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Group Type:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spinnerGroupType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignments (Subject &amp; Teacher):"
            android:textStyle="bold"
            android:textColor="#2E8B57"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/layoutPairsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddPairRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Assignment"
            android:backgroundTint="#2E8B57"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveClass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Create Group ✅"
            android:textSize="18sp"
            android:backgroundTint="#005088"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>