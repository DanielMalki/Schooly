<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvClassDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School (Read Only)"
            android:textStyle="bold"
            android:textColor="#555555"/>
        <EditText
            android:id="@+id/etClassSchoolLocked"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#EEEEEE"
            android:paddingStart="12dp"
            android:focusable="false"
            android:clickable="false"
            android:inputType="none"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grade"
            android:textStyle="bold"
            android:textColor="#555555"/>
        <Spinner
            android:id="@+id/spinnerGradeSelect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class Type (Read Only)"
            android:textStyle="bold"
            android:textColor="#555555"/>
        <EditText
            android:id="@+id/etClassTypeLocked"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#EEEEEE"
            android:paddingStart="12dp"
            android:focusable="false"
            android:clickable="false"
            android:inputType="none"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class Name"
            android:textStyle="bold"
            android:textColor="#555555"/>
        <EditText
            android:id="@+id/etClassName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#EEEEEE"
            android:paddingStart="12dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignments (Subject &amp; Teacher):"
            android:textStyle="bold"
            android:textColor="#2E8B57"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/layoutPairsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAddPairRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Assignment"
            android:backgroundTint="#2E8B57"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvStudentsListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enrolled Students"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutClassStudentsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveClassDetails"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save Class Changes"
            android:textSize="16sp"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"/>

        <Button
            android:id="@+id/btnDeleteClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Class"
            android:textColor="@android:color/white"
            android:backgroundTint="#D32F2F"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>