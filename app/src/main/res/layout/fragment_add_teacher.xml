<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Teachable Subjects:"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"
        android:textColor="#E65100"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvSelectSubjects"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#EEEEEE"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Tap to select subjects..."
            android:textColor="#333333"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnQuickAddSubject"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_edittext_bg"
            android:backgroundTint="#E65100"
            android:contentDescription="Quick add subject"
            android:src="@android:drawable/ic_input_add"
            app:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSelectedSubjectsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="15dp" />

</LinearLayout>