<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New User"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select User Role:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>
        <Spinner
            android:id="@+id/spinnerRole"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvSchoolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select School:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"
            android:visibility="gone"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">
            <Spinner
                android:id="@+id/spinnerSchoolSelect"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="#EEEEEE"
                android:visibility="gone"/>
            <ImageButton
                android:id="@+id/btnQuickAddSchool"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_input_add"
                android:backgroundTint="#1A237E"
                app:tint="@android:color/white"
                android:background="@drawable/rounded_edittext_bg"
                android:visibility="gone"/>
        </LinearLayout>
        <EditText
            android:id="@+id/etSchoolLocked"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="10dp"
            android:background="#EEEEEE"
            android:enabled="false"
            android:textColor="#333333"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Personal Details:"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:textColor="#333333"/>
        <EditText android:id="@+id/etTz" android:layout_width="match_parent" android:layout_height="50dp" android:hint="TZ / ID Number" android:inputType="number" android:padding="10dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etFirstName" android:layout_width="match_parent" android:layout_height="50dp" android:hint="First Name" android:padding="10dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etLastName" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Last Name" android:padding="10dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etMiddleName" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Middle Name (Optional)" android:padding="10dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Email Address" android:inputType="textEmailAddress" android:padding="10dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Password" android:inputType="textPassword" android:padding="10dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>

        <FrameLayout
            android:id="@+id/roleSpecificContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnSaveUser"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Create User"
            android:textSize="18sp"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"
            android:layout_marginBottom="20dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" android:layout_marginBottom="15dp"/>
        <Button
            android:id="@+id/btnGoToCsvImport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Bulk Import via CSV 📂"
            android:textSize="16sp"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>