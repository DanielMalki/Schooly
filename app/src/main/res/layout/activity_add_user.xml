<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New User"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select User Role:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <Spinner
            android:id="@+id/spinnerRole"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:background="#EEEEEE"/>

        <TextView
            android:id="@+id/tvSchoolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School Assignment:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etSchoolLocked"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#E0E0E0"
            android:focusable="false"
            android:clickable="false"
            android:padding="10dp"
            android:textColor="#555555"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <Spinner
                android:id="@+id/spinnerSchoolSelect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:background="#EEEEEE"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/btnQuickAddSchool"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_input_add"
                android:backgroundTint="#1A237E"
                app:tint="@android:color/white"
                android:visibility="gone"
                android:contentDescription="Quick add school" />
        </LinearLayout>

        <View
            android:id="@+id/viewSchoolDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Personal Information:"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etNewTz"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="ID Number (T.Z) *"
            android:inputType="number"
            android:layout_marginBottom="15dp"
            android:background="#EEEEEE"
            android:padding="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:hint="First Name *"
                android:inputType="textPersonName"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:layout_marginEnd="5dp"/>

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:hint="Last Name *"
                android:inputType="textPersonName"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:layout_marginStart="5dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etMiddleName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Middle Name (Optional)"
            android:inputType="textPersonName"
            android:layout_marginBottom="15dp"
            android:background="#EEEEEE"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/etNewEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email Address *"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="15dp"
            android:background="#EEEEEE"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Password *"
            android:inputType="textPassword"
            android:layout_marginBottom="15dp"
            android:background="#EEEEEE"
            android:padding="10dp"/>

        <LinearLayout
            android:id="@+id/layoutStudentFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Assign Student to Learning Groups:"
                android:textStyle="bold"
                android:textColor="#FF5722"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mandatory Classes (*)"
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerHomeroom"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="#FFF3E0"/>

            <Spinner
                android:id="@+id/spinnerMathGroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="#FFF3E0"/>

            <Spinner
                android:id="@+id/spinnerEnglishGroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="#FFF3E0"/>

            <Spinner
                android:id="@+id/spinnerPeGroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="15dp"
                android:background="#FFF3E0"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Optional Majors (Leave unselected if none)"
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerMajorAGroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="#E8F5E9"/>

            <Spinner
                android:id="@+id/spinnerMajorBGroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="15dp"
                android:background="#E8F5E9"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTeacherFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Teacher / School Admin Subjects Setup:"
                android:textStyle="bold"
                android:textColor="#2E8B57"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvSelectSubjects"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Select Teachable Subjects *"
                    android:textColor="#666666"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageButton
                    android:id="@+id/btnQuickAddSubject"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_input_add"
                    android:backgroundTint="#1A237E"
                    app:tint="@android:color/white"
                    android:background="@drawable/rounded_edittext_bg"
                    android:contentDescription="Quick add subject" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSelectedSubjectsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:paddingStart="10dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveUser"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Save User"
            android:textSize="18sp"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>