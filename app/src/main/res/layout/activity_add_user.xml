<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New User"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select User Role:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"/>

        <Spinner
            android:id="@+id/spinnerRole"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvSchoolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select School:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:textColor="#333333"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">

            <Spinner
                android:id="@+id/spinnerSchoolSelect"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="#EEEEEE"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/btnQuickAddSchool"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_input_add"
                android:backgroundTint="#1A237E"
                app:tint="@android:color/white"
                android:background="@drawable/rounded_edittext_bg"
                android:visibility="gone"
                android:contentDescription="Quick add school"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etSchoolLocked"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="10dp"
            android:background="#EEEEEE"
            android:enabled="false"
            android:textColor="#333333"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <View
            android:id="@+id/viewSchoolDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:visibility="gone"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Personal Details:"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etTz"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="ID Number (TZ)"
            android:inputType="number"
            android:maxLength="9"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="First Name"
            android:inputType="textPersonName"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etMiddleName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Middle Name (Optional)"
            android:inputType="textPersonName"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Last Name"
            android:inputType="textPersonName"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Login Credentials:"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Password (min. 6 characters)"
            android:inputType="textPassword"
            android:paddingStart="15dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:id="@+id/layoutStudentGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Learning Groups (Mandatory):"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#2E8B57"/>

            <TextView android:text="Homeroom Class:" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/spinnerHomeroom" android:layout_width="match_parent" android:layout_height="45dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

            <TextView android:text="Math Group:" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/spinnerMathGroup" android:layout_width="match_parent" android:layout_height="45dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

            <TextView android:text="English Group:" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/spinnerEnglishGroup" android:layout_width="match_parent" android:layout_height="45dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

            <TextView android:text="Physical Education Group:" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/spinnerPeGroup" android:layout_width="match_parent" android:layout_height="45dp" android:background="#EEEEEE" android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Major Subjects (Optional):"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#2E8B57"/>

            <TextView android:text="Major A:" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/spinnerMajorAGroup" android:layout_width="match_parent" android:layout_height="45dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

            <TextView android:text="Major B:" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/spinnerMajorBGroup" android:layout_width="match_parent" android:layout_height="45dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTeacherSubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Can Teach Subjects:"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#D84315"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvSelectSubjects"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Select Subjects..."
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:background="@drawable/rounded_edittext_bg"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageButton
                    android:id="@+id/btnQuickAddSubject"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_input_add"
                    android:backgroundTint="#1A237E"
                    app:tint="@android:color/white"
                    android:background="@drawable/rounded_edittext_bg"
                    android:contentDescription="Quick add subject" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSelectedSubjectsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:paddingStart="10dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveUser"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Save User"
            android:textSize="18sp"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#DDDDDD"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bulk Import (CSV)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teachers CSV (6 cols):\ntz, first, last, email, password, middle name\n\nStudents CSV (12 cols):\ntz, first, last, email, password, middle name, homeroom, math, english, sports, major a, major b"
            android:textSize="13sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnImportTeachers"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Import Teachers CSV 📂"
            android:textSize="16sp"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnImportStudents"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Import Students CSV 📂"
            android:textSize="16sp"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>